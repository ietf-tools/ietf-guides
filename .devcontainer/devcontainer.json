// For format details, see https://aka.ms/devcontainer.json.
{
	"name": "IETF Guides",
	"dockerComposeFile": ["../docker-compose.yml", "docker-compose.devcontainer.yml"],
	"service": "app",
	"workspaceFolder": "/code",

	// The image runs as the unprivileged "guides" user. Keep its uid as built:
	// /opt/venv and /run/guides are owned by uid 1000 in the image, and letting
	// VS Code remap the uid would leave them unwritable. On a Linux host whose
	// uid is not 1000, rebuild with APP_UID/APP_GID set to match (see
	// docker-compose.yml) so the bind-mounted workspace stays writable.
	"remoteUser": "guides",
	"updateRemoteUserUID": false,

	// The production entrypoint is replaced in docker-compose.devcontainer.yml,
	// so we manage the process ourselves — don't let devcontainer override the command.
	"overrideCommand": false,

	// Stop all compose services when the devcontainer exits (docker compose stop).
	// Note: containers are stopped but not removed; use docker compose down manually if needed.
	"shutdownAction": "stopCompose",

	// Port 8080: nginx (serves static files, proxies dynamic requests to manage.py runserver on 8000).
	// Port 8026: Mailpit UI (mapped from the mailpit service by docker-compose.yml).
	"forwardPorts": [8080, 5432, 8026],
	"portsAttributes": {
		"8080": {
			"label": "App (nginx)",
			"onAutoForward": "notify"
		},
		"5432": {
			"label": "PostgreSQL",
			"onAutoForward": "silent"
		},
		"8026": {
			"label": "Mailpit UI",
			"onAutoForward": "notify"
		},
		"8000": {
			"label": "runserver (use port 8080/nginx instead)",
			"onAutoForward": "ignore"
		}
	},

	// Reinstall dependencies in case requirements.txt changed since the image was built.
	"postCreateCommand": "pip install -r requirements.txt",

	"customizations": {
		"vscode": {
			"settings": {
				"python.defaultInterpreterPath": "/opt/venv/bin/python"
			},
			"extensions": [
				"ms-python.python",
				"ms-python.pylint"
			]
		}
	}
}
